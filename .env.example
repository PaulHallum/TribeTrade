# Google OAuth: Required for Gmail and Calendar sync.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"

# Yahoo / Sky Mail OAuth Credentials
YAHOO_APP_ID="MY_YAHOO_APP_ID"
YAHOO_CLIENT_ID="MY_YAHOO_CLIENT_ID"
YAHOO_CLIENT_SECRET="MY_YAHOO_CLIENT_SECRET"

# Microsoft Outlook / Office 365 OAuth Credentials
MICROSOFT_CLIENT_ID="MY_MICROSOFT_CLIENT_ID"
MICROSOFT_CLIENT_SECRET="MY_MICROSOFT_CLIENT_SECRET"
MICROSOFT_TENANT_ID="common"


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe Payments
# Get these from https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PRICE_ID_MONTHLY="price_1U0LNyJzUUmzIl9XtVTb93C6"
STRIPE_PRICE_ID_YEARLY="price_1U0LOZJzUUmzIl9XNhlQ3t7i"
STRIPE_WEBHOOK_SECRET="whsec_..."
